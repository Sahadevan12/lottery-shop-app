# Flutter / Dart ignore rules
.dart_tool/
.packages
build/
pubspec.lock

# Local environment secrets (never commit!)
env.json
.env
*.env

# Supabase CLI local temp/link state
supabase/.temp/
supabase/.branches/

# Android / Kotlin build temp logs & release signing credentials (never commit!)
android/.kotlin/
android/key.properties
android/app/upload-keystore.jks
android/app/google-services.json
*.jks
*.keystore
